<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="customer_manager.PrimaryController"
      alignment="TOP_LEFT"
      spacing="12">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Customer Manager" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="_Name:" mnemonicParsing="true"/>
        <TextField fx:id="nameField" promptText="Enter customer name"/>
        <Label text="_Province:" mnemonicParsing="true"/>
        <ComboBox fx:id="provinceBox" promptText="Choose a province"/>
    </HBox>

    <HBox spacing="10">
        <Button fx:id="addButton" text="_Add Customer" mnemonicParsing="true" onAction="#addCustomer"/>
        <Button fx:id="deleteButton" text="_Delete Selected" mnemonicParsing="true" onAction="#deleteCustomer"/>
    </HBox>

    <TableView fx:id="customerTable" prefHeight="350">
        <columns>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="250"/>
            <TableColumn fx:id="provinceColumn" text="Province" prefWidth="200"/>
        </columns>
    </TableView>
</VBox>